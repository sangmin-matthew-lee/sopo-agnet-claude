// Render: dot -Tpng -Gdpi=140 docs/architecture.dot -o docs/architecture.png
// System view: who talks to whom, what leaves the local server (masked tokens only), where keys live.
digraph SOPO_ARCH {
  graph [rankdir=TB, fontname="Apple SD Gothic Neo", nodesep=0.35, ranksep=0.28, bgcolor="white",
         pad=0.35, newrank=true, compound=true, splines=spline];
  node  [shape=plain, fontname="Apple SD Gothic Neo"];
  edge  [fontname="Apple SD Gothic Neo", fontsize=10, color="#1e293b", penwidth=1.3, arrowsize=0.7];

  // ------------------------------------------------------------------ left: people
  customer [label=<
    <TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLPADDING="3" CELLSPACING="0" STYLE="rounded" BGCOLOR="white">
      <TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">고객사 담당자</FONT></B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#334155">반품 · 기술 지원 메일, 같은 스레드로 답장<BR ALIGN="LEFT"/></FONT></TD></TR>
    </TABLE>>];

  staff [label=<
    <TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLPADDING="3" CELLSPACING="0" STYLE="rounded" BGCOLOR="white">
      <TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">AxMatt Supply 직원</FONT></B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#334155">AM · 엔지니어: 이관 메일 · 초대장 수신<BR ALIGN="LEFT"/></FONT></TD></TR>
    </TABLE>>];

  // ------------------------------------------------------------------ middle: local server
  subgraph cluster_local {
    label=<<TABLE BORDER="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="13" COLOR="#c2410c">로컬 서버 (FastAPI · uvicorn)</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#c2410c">실제 값(주문·부품·라벨·링크·직원)은 여기서만 존재</FONT></TD></TR></TABLE>>;
    labeljust=l; style="rounded,dashed"; color="#ea580c"; penwidth=1.6; bgcolor="#fff7ed"; margin=8;

    api [label=<
      <TABLE BORDER="1" COLOR="#ea580c" CELLBORDER="0" CELLPADDING="3" CELLSPACING="0" STYLE="rounded" BGCOLOR="white">
        <TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="13">샌드박스 UI · API</FONT></B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#334155">요청 제한 → 패스코드 · X-Ray 스트리밍<BR ALIGN="LEFT"/></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#c2410c">main.py · static/index.html</FONT></TD></TR>
      </TABLE>>];

    mask [label=<
      <TABLE BORDER="1" COLOR="#ea580c" CELLBORDER="0" CELLPADDING="3" CELLSPACING="0" STYLE="rounded" BGCOLOR="white">
        <TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="13">Phase 1 · 전처리 + 마스킹</FONT></B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#334155">중복 차단 · HTML/인용/서명 제거<BR ALIGN="LEFT"/>ORD-9988 → &lt;ORDER_TOKEN_1&gt; (Vault)<BR ALIGN="LEFT"/></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#c2410c">pipeline.py · core/masker.py</FONT></TD></TR>
      </TABLE>>];

    router [label=<
      <TABLE BORDER="1" COLOR="#ea580c" CELLBORDER="0" CELLPADDING="3" CELLSPACING="0" STYLE="rounded" BGCOLOR="white">
        <TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="13">Phase 2 · 규칙 기반 라우터</FONT></B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#334155">A 차단 · B 이관 · C1 반품 · C2 기술<BR ALIGN="LEFT"/></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#c2410c">core/jev_router.py</FONT></TD></TR>
      </TABLE>>];

    subgraph cluster_agents {
      label=<<B><FONT POINT-SIZE="11" COLOR="#6d28d9">sop_agents/</FONT></B>>; labeljust=r;
      style="rounded,dashed"; color="#8b5cf6"; bgcolor="#f5f3ff"; margin=6;

      agents [label=<
        <TABLE BORDER="1" COLOR="#8b5cf6" CELLBORDER="0" CELLPADDING="3" CELLSPACING="0" STYLE="rounded" BGCOLOR="white">
          <TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="13">Phase 3 · 전문 에이전트</FONT></B></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#334155">Return · Tech Support Agent<BR ALIGN="LEFT"/>토큰만 보고 도구 선택 · 원본 가드<BR ALIGN="LEFT"/></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#6d28d9">return_agent.py · tech_agent.py</FONT></TD></TR>
        </TABLE>>];

      tools [label=<
        <TABLE BORDER="1" COLOR="#8b5cf6" CELLBORDER="0" CELLPADDING="3" CELLSPACING="0" STYLE="rounded" BGCOLOR="white">
          <TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="13">Phase 4 · 로컬 도구</FONT></B></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#334155">토큰 → 실제 값 복원 · 본인 확인<BR ALIGN="LEFT"/>반품 자격 · 라벨 · 캘린더 · 예약<BR ALIGN="LEFT"/></FONT></TD></TR>
          <TR><TD ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#6d28d9">core/scheduling.py</FONT></TD></TR>
        </TABLE>>];
    }

    sqlite [label=<
      <TABLE BORDER="1" COLOR="#ea580c" CELLBORDER="0" CELLPADDING="3" CELLSPACING="0" STYLE="rounded" BGCOLOR="white">
        <TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="13">SQLite (sop_demo.db)</FONT></B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#334155">주문 · Vault · 캘린더 · 미팅<BR ALIGN="LEFT"/>인박스 · 에이전트 대화 기록<BR ALIGN="LEFT"/></FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#c2410c">core/db.py</FONT></TD></TR>
      </TABLE>>];

    keys [label=<
      <TABLE BORDER="1" COLOR="#ea580c" CELLBORDER="0" CELLPADDING="3" CELLSPACING="0" STYLE="rounded" BGCOLOR="white">
        <TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="13">키 보관 (.env)</FONT></B></TD></TR>
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#334155">API 키 · 패스코드<BR ALIGN="LEFT"/>로컬에만 (깃 X)<BR ALIGN="LEFT"/></FONT></TD></TR>
      </TABLE>>];
  }

  // ------------------------------------------------------------------ right: external AI (masked only)
  jev [label=<
    <TABLE BORDER="1" COLOR="#3b82f6" CELLBORDER="0" CELLPADDING="3" CELLSPACING="0" STYLE="rounded" BGCOLOR="#eff6ff">
      <TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">TypeSafe AI · Jev</FONT></B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#334155">스팸 · 의도 · 분노 (1회 호출)<BR ALIGN="LEFT"/></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#2563eb">마스킹된 텍스트만 수신</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><TABLE BORDER="1" COLOR="#dc2626" CELLBORDER="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="#fee2e2"><TR><TD><FONT POINT-SIZE="10" COLOR="#991b1b"><B>TYPESAFE_API_KEY</B></FONT></TD></TR></TABLE></TD></TR>
    </TABLE>>];

  openai [label=<
    <TABLE BORDER="1" COLOR="#3b82f6" CELLBORDER="0" CELLPADDING="3" CELLSPACING="0" STYLE="rounded" BGCOLOR="#eff6ff">
      <TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">OpenAI</FONT></B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#334155">메일 초안 · 도구 호출 결정<BR ALIGN="LEFT"/></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#2563eb">gpt-4o-mini · Agents SDK</FONT></TD></TR>
            <TR><TD ALIGN="LEFT"><TABLE BORDER="1" COLOR="#dc2626" CELLBORDER="0" CELLPADDING="3" STYLE="rounded" BGCOLOR="#fee2e2"><TR><TD><FONT POINT-SIZE="10" COLOR="#991b1b"><B>OPENAI_API_KEY</B></FONT></TD></TR></TABLE></TD></TR>
    </TABLE>>];

  inbox [label=<
    <TABLE BORDER="1" COLOR="#16a34a" CELLBORDER="0" CELLPADDING="3" CELLSPACING="0" STYLE="rounded" BGCOLOR="#f0fdf4">
      <TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">인박스 (시뮬레이션)</FONT></B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#15803d">CUSTOMER_INBOX</FONT><FONT POINT-SIZE="11" COLOR="#334155"> 고객</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#15803d">SOP_EMPLOYEE_INBOX</FONT><FONT POINT-SIZE="11" COLOR="#334155"> AM</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT FACE="Menlo" POINT-SIZE="10" COLOR="#15803d">ENGINEER_INBOX</FONT><FONT POINT-SIZE="11" COLOR="#334155"> 엔지니어</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#64748b">DB 테이블 (실제 메일 X)</FONT></TD></TR>
    </TABLE>>];

  // numbered step badge
  // (edge labels below use a dark rounded chip with the step number)

  // ------------------------------------------------------------------ layout: rows (TB), left→right order
  { rank=same; customer -> api -> keys [style=invis]; }
  { rank=same; mask -> jev [style=invis]; }
  { rank=same; agents -> openai [style=invis]; }
  { rank=same; inbox -> tools [style=invis]; }
  { rank=same; staff -> sqlite [style=invis]; }
  customer -> inbox -> staff [style=invis, weight=10];
  api -> mask -> router -> agents -> tools -> sqlite [style=invis, weight=20];

  // ------------------------------------------------------------------ flow (numbered like the request path)
  customer -> api   [label=<<TABLE BORDER="0" CELLPADDING="2" CELLSPACING="2"><TR><TD BGCOLOR="#1e293b" STYLE="rounded"><FONT COLOR="white" POINT-SIZE="11"><B> 1 </B></FONT></TD><TD><FONT POINT-SIZE="10" COLOR="#334155"> 이메일</FONT></TD></TR></TABLE>>, weight=0];
  api -> mask       [label=<<TABLE BORDER="0" CELLPADDING="2" CELLSPACING="2"><TR><TD BGCOLOR="#1e293b" STYLE="rounded"><FONT COLOR="white" POINT-SIZE="11"><B> 2 </B></FONT></TD><TD><FONT POINT-SIZE="10" COLOR="#334155"> 통과</FONT></TD></TR></TABLE>>];
  mask -> jev       [label=<<TABLE BORDER="0" CELLPADDING="2" CELLSPACING="2"><TR><TD BGCOLOR="#1e293b" STYLE="rounded"><FONT COLOR="white" POINT-SIZE="11"><B> 3 </B></FONT></TD><TD><FONT POINT-SIZE="10" COLOR="#334155"> 마스킹된 본문만</FONT></TD></TR></TABLE>>, color="#2563eb"];
  jev -> router     [label=" 점수", color="#2563eb", fontcolor="#1d4ed8", style=dashed];
  router -> agents  [label=<<TABLE BORDER="0" CELLPADDING="2" CELLSPACING="2"><TR><TD BGCOLOR="#1e293b" STYLE="rounded"><FONT COLOR="white" POINT-SIZE="11"><B> 4 </B></FONT></TD><TD><FONT POINT-SIZE="10" COLOR="#334155"> Path C</FONT></TD></TR></TABLE>>];
  agents -> openai  [label=<<TABLE BORDER="0" CELLPADDING="2" CELLSPACING="2"><TR><TD BGCOLOR="#1e293b" STYLE="rounded"><FONT COLOR="white" POINT-SIZE="11"><B> 5 </B></FONT></TD><TD><FONT POINT-SIZE="10" COLOR="#334155"> &lt;TOKEN&gt;만 왕복</FONT></TD></TR></TABLE>>, dir=both, color="#2563eb"];
  agents -> tools   [label=" 도구 호출"];
  tools -> sqlite   [label=<<TABLE BORDER="0" CELLPADDING="2" CELLSPACING="2"><TR><TD BGCOLOR="#1e293b" STYLE="rounded"><FONT COLOR="white" POINT-SIZE="11"><B> 6 </B></FONT></TD><TD><FONT POINT-SIZE="10" COLOR="#334155"> 조회 · 저장</FONT></TD></TR></TABLE>>, dir=both];
  tools -> inbox    [label=<<TABLE BORDER="0" CELLPADDING="2" CELLSPACING="2"><TR><TD BGCOLOR="#1e293b" STYLE="rounded"><FONT COLOR="white" POINT-SIZE="11"><B> 7 </B></FONT></TD><TD><FONT POINT-SIZE="10" COLOR="#334155"> 실제 값으로 발송</FONT></TD></TR></TABLE>>, color="#16a34a"];
  router -> inbox   [xlabel="A 차단 / B 이관 (OpenAI X)", style=dashed, color="#d97706", fontcolor="#b45309", constraint=false];

  inbox -> staff    [label=" 확인", style=dashed, color="#16a34a", fontcolor="#15803d"];
  inbox -> customer [xlabel="답장 → 다시 ①", style=dashed, color="#16a34a", fontcolor="#15803d", constraint=false];
}
