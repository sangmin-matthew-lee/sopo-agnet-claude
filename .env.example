# Copy to .env and fill in. Load it with: uv run --env-file .env uvicorn main:app --port 8080
DEMO_ACCESS_CODE=change-me
TYPESAFE_API_KEY=
OPENAI_API_KEY=

# Optional
# SOP_DB_PATH=sop_demo.db
# JEV_MODEL=jev-latest
# RETURN_AGENT_MODEL=gpt-4o-mini
# RATE_LIMIT_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60

# -------------- real email test mode (Resend) --------------
# Off by default: the sandbox (/ and /api/simulate-email*) never sends real email, whatever this says.
# MAIL_MODE only turns live RECEIVING on: simulated = /webhook/resend answers 503, resend = it accepts mail.
# MAIL_MODE=simulated
# RESEND_API_KEY=re_...                  # Resend API key (sending + reading received mail). Secret.
# RESEND_WEBHOOK_SECRET=whsec_...        # signing secret of the email.received webhook. Secret.
# TEST_DOMAIN=test.example.com           # subdomain whose MX points to Resend (root-domain mail untouched)
# SUPPORT_ADDRESS=support@test.example.com  # testers email this; default support@TEST_DOMAIN
# AM_ADDRESS=am@test.example.com         # all account-manager / SOP mail is delivered here; default am@TEST_DOMAIN
# ENG_ADDRESS=eng@test.example.com       # all engineer mail is delivered here; default eng@TEST_DOMAIN
# TESTER_INVITE_CODE=                    # needed to sign up at /tester (empty = sign-up closed). Secret.
# MAX_TESTERS=10                         # sign-up cap
# RESEND_DAILY_LIMIT=100                 # free plan: sent + received share 100/day (resets 00:00 UTC)
# RESEND_MONTHLY_LIMIT=3000              # ... and 3,000/month
# PUBLIC_BASE_URL=https://sopo.example.com  # used to build tester dashboard links; default = request host
# REQUIRE_SENDER_AUTH=true               # only accept tester mail that passed DKIM or DMARC (anti-spoofing)
